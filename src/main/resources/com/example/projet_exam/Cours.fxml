<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="490.0" prefWidth="935.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.projet_exam.CoursController">

    <children>
        <!-- Header -->
        <HBox alignment="CENTER_LEFT" layoutX="20" layoutY="15" spacing="10">
            <children>
                <Label text="Gestion des Cours">
                    <font>
                        <Font name="Arial Bold" size="22.0" />
                    </font>
                    <textFill>
                        <LinearGradient endX="1.0" endY="1.0" startX="0.0" startY="0.0">
                            <stops>
                                <Stop color="#0598ff" offset="0.0" />
                                <Stop color="#0353a4" offset="1.0" />
                            </stops>
                        </LinearGradient>
                    </textFill>
                </Label>
            </children>
        </HBox>

        <!-- Zone de recherche -->
        <HBox layoutX="250.0" layoutY="70.0" spacing="10" />

        <!-- Formulaire d'ajout/modification -->
        <VBox fx:id="txtform" layoutX="35.0" layoutY="40.0" prefHeight="300.0" prefWidth="200.0" spacing="8" style="-fx-background-color: WHITE; -fx-border-radius: 10px; -fx-border-color: #ccc; -fx-padding: 10;">
            <children>
                <Label style="-fx-font-weight: bold; -fx-text-fill: #333;" text="Ajouter / Modifier un Cours" />
                <Label text="Nom" />
                <TextField fx:id="txtNom" prefHeight="25.0" prefWidth="170.0" />
                <Label text="Description" />
                <TextField fx:id="txtDescription" prefHeight="25.0" prefWidth="170.0" />
                <Label text="Heure Début" />
                <TextField fx:id="txtHeureDebut" prefHeight="25.0" prefWidth="170.0" promptText="yyyy-mm-jjTHH:mm:ss" />
                <Label text="Heure Fin" />
                <TextField fx:id="txtHeureFin" prefHeight="25.0" prefWidth="170.0" promptText="yyyy-mm-jjTHH:mm:ss" />
                <Label text="Salle" />
                <ComboBox fx:id="comboSalle" prefHeight="25.0" prefWidth="170.0" />
                <Label text="Professeur" />
                <ComboBox fx:id="comboProfesseur" prefHeight="25.0" prefWidth="170.0" />
                <Button fx:id="Clear" mnemonicParsing="false" onAction="#onClear" prefHeight="25.0" prefWidth="70.0" style="-fx-background-color: #f44336; -fx-text-fill: WHITE;" text="Clear" />
            </children>
        </VBox>

        <!-- Tableau des cours -->
        <TableView fx:id="coursTable" layoutX="243.0" layoutY="95.0" onMouseClicked="#Load" prefHeight="335.0" prefWidth="669.0">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="nomColumn" prefWidth="65.33334350585938" text="Nom" />
                <TableColumn fx:id="descriptionColumn" prefWidth="88.66665649414062" text="Description" />
                <TableColumn fx:id="heureDebutColumn" prefWidth="162.66671752929688" text="Heure Début" />
                <TableColumn fx:id="heureFinColumn" prefWidth="161.33331298828125" text="Heure Fin" />
                <TableColumn fx:id="salleColumn" prefWidth="138.6666259765625" text="Salle" />
            </columns>
        </TableView>

        <!-- Boutons -->
        <HBox layoutX="250.0" layoutY="440.0" spacing="15.0">
            <children>
                <Button fx:id="bAdd" mnemonicParsing="false" onAction="#onAdd" prefHeight="27.0" prefWidth="80.0" style="-fx-background-color: #0598ff; -fx-text-fill: WHITE;" text="Ajouter" />
                <Button fx:id="bUpdate" mnemonicParsing="false" onAction="#onUpdate" prefHeight="28.0" prefWidth="80.0" style="-fx-background-color: #ff9800; -fx-text-fill: WHITE;" text="Modifier" />
                <Button fx:id="bDelete" mnemonicParsing="false" onAction="#onDelete" prefHeight="27.0" prefWidth="79.0" style="-fx-background-color: #f44336; -fx-text-fill: WHITE;" text="Supprimer" />
            </children>
        </HBox>
          <TextField fx:id="txtSearch" layoutX="285.0" layoutY="39.0" prefHeight="30.0" prefWidth="300.0" promptText="Rechercher un cours..." style="-fx-background-radius: 20px; -fx-border-radius: 20px; -fx-border-color: #0598ff;" />
          <Button fx:id="bSearch" layoutX="612.0" layoutY="40.0" mnemonicParsing="false" onAction="#onSearch" prefHeight="30.0" prefWidth="90.0" style="-fx-background-color: #0598ff; -fx-background-radius: 20px;" text="Rechercher" textFill="WHITE" />
    </children>
</AnchorPane>
