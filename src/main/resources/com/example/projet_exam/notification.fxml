<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.LinearGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="466.0" prefWidth="857.0" style="-fx-background-color: #f0f0f0;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.example.projet_exam.NotificationController">
   <children>
      <TextArea fx:id="txtMessage" layoutX="20.0" layoutY="161.0" prefHeight="100" prefWidth="273.0" promptText="Entrez le message ici..." style="-fx-border-color: #007bff; -fx-border-radius: 5;" />
      <Label layoutX="24.0" layoutY="134.0" text="message">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <ComboBox fx:id="cmbDestinataire" layoutX="24.0" layoutY="305.0" prefHeight="25.0" prefWidth="265.0" />
      <Label layoutX="24.0" layoutY="278.0" text="destinataire">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <Button fx:id="btnEnvoyer" layoutX="23.0" layoutY="350.0" mnemonicParsing="false" onAction="#onEnvoyer" prefHeight="34.0" prefWidth="101.0" style="-fx-background-color: #0598ff;" text="envoyer" textFill="WHITE">
         <font>
            <Font name="System Bold" size="15.0" />
         </font>
      </Button>
      <TableView fx:id="notiTable" layoutX="321.0" layoutY="73.0" prefHeight="355.0" prefWidth="526.0">
        <columns>
          <TableColumn fx:id="IdColumn" prefWidth="48.0" text="ID" />
          <TableColumn fx:id="dateColumn" prefWidth="111.99996948242188" text="date envoie" />
            <TableColumn fx:id="destinataireColumn" prefWidth="111.3333740234375" text="destinataire" />
            <TableColumn fx:id="messageColumn" prefWidth="254.0" text="message" />
        </columns>
      </TableView>
      <Label layoutX="10.0" layoutY="10.0" text="Gestion Notification">
         <font>
            <Font name="Arial Bold" size="28.0" />
         </font>
         <textFill>
            <LinearGradient endX="1.0" endY="1.0" startX="0.0" startY="0.0">
               <stops>
                  <Stop color="#0598ff" offset="0.0" />
                  <Stop color="#0353a4" offset="1.0" />
               </stops>
            </LinearGradient>
         </textFill>
      </Label>
      <Label layoutX="24.0" layoutY="73.0" text="titre du message">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      <TextField fx:id="txtTitre" layoutX="22.0" layoutY="100.0" prefHeight="34.0" prefWidth="273.0" />
   </children>
</AnchorPane>
