<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.example.projet_exam.CoursController" prefWidth="600" prefHeight="400" style="-fx-background-color: #f0f0f0;">
    <VBox spacing="10" alignment="TOP_CENTER" style="-fx-padding: 10;">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10" />
        </padding>

        <!-- Formulaire d'ajout de cours -->
        <GridPane hgap="8" vgap="8" style="-fx-background-color: #ffffff; -fx-border-color: #007bff; -fx-border-radius: 5; -fx-padding: 10; -fx-background-insets: 5;">
            <Label text="ID:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
            <TextField fx:id="txtId" GridPane.rowIndex="0" GridPane.columnIndex="1" promptText="ID" disable="true" prefWidth="150"/>

            <Label text="Nom:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
            <TextField fx:id="txtNom" GridPane.rowIndex="1" GridPane.columnIndex="1" promptText="Nom" prefWidth="150"/>

            <Label text="Description:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
            <TextField fx:id="txtDescription" GridPane.rowIndex="2" GridPane.columnIndex="1" promptText="Description" prefWidth="150"/>

            <Label text="Heure Début:" GridPane.rowIndex="3" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
            <TextField fx:id="txtHeureDebut" GridPane.rowIndex="3" GridPane.columnIndex="1" promptText="YYYY-MM-DDTHH:MM" prefWidth="150"/>

            <Label text="Heure Fin:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
            <TextField fx:id="txtHeureFin" GridPane.rowIndex="4" GridPane.columnIndex="1" promptText="YYYY-MM-DDTHH:MM" prefWidth="150"/>

            <Label text="Salle:" GridPane.rowIndex="5" GridPane.columnIndex="0" style="-fx-font-weight: bold;" />
            <ComboBox fx:id="comboSalle" GridPane.rowIndex="5" GridPane.columnIndex="1" promptText="Salle" prefWidth="150"/>
        </GridPane>

        <!-- Barre de recherche -->
        <TextField fx:id="txtSearch" promptText="Rechercher un cours..." prefWidth="200" style="-fx-background-color: #ffffff; -fx-border-color: #007bff; -fx-border-radius: 5;"/>

        <!-- TableView des cours -->
        <TableView fx:id="coursTable" prefHeight="150" style="-fx-background-color: #ffffff; -fx-border-color: #007bff; -fx-border-radius: 5;">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50" />
                <TableColumn fx:id="nomColumn" text="Nom" prefWidth="100" />
                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="150" />
                <TableColumn fx:id="heureDebutColumn" text="Début" prefWidth="100" />
                <TableColumn fx:id="heureFinColumn" text="Fin" prefWidth="100" />
                <TableColumn fx:id="salleColumn" text="Salle" prefWidth="100" />
            </columns>
        </TableView>

        <!-- Boutons d'action -->
        <HBox spacing="10" alignment="CENTER">
            <Button text="Ajouter" onAction="#onAdd" prefWidth="80" style="-fx-background-color: #007bff; -fx-text-fill: white;"/>
            <Button text="Modifier" onAction="#onUpdate" prefWidth="80" style="-fx-background-color: #007bff; -fx-text-fill: white;"/>
            <Button text="Supprimer" onAction="#onDelete" prefWidth="80" style="-fx-background-color: #dc3545; -fx-text-fill: white;"/>
            <Button text="Effacer" onAction="#onClear" prefWidth="80" style="-fx-background-color: #dc3545; -fx-text-fill: white;"/>
        </HBox>
    </VBox>
</AnchorPane>